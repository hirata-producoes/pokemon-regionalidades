	GAME_CODE   	:= BPRE
	BUILD_NAME  	:= firered
	MAP_VERSION 	:= firered
else
ifeq (leafgreen, $(or $(BUILD), $(MAKECMDGOALS)))
	GAME_VERSION 	:= LEAFGREEN
	TITLE       	:= POKEMON LEAF
	GAME_CODE   	:= BPGE
	BUILD_NAME  	:= leafgreen
