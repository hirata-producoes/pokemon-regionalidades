# Native Windows final link. A response file avoids the Windows command-line
# length limit once Expansion contributes thousands of objects.
PLATFORM_LIBS := -lmingw32 -lSDL2main -lSDL2.dll -lwinmm -lxinput

$(ROM): $(OBJS) $(PC_RESOURCE_ASSETS)
	$(file >$(OBJ_DIR)/objects.rsp,$(OBJS))
	$(CC) $(CFLAGS) -Wl,--demangle -Wl,-Map,$(MAP) @$(OBJ_DIR)/objects.rsp -static-libgcc -L$(SDL_DIR)/lib $(PLATFORM_LIBS) -o $@

$(RESOURCE_PACK): $(PC_RESOURCE_ASSETS) $(PC_RESOURCE_SOURCE_FILES) $(PC_POKEMON_RESOURCE_ASSETS) \
		$(PC_CRY_RESOURCE_ASSETS) $(PC_POKEMON_RESOURCE_LIST) $(PC_CRY_RESOURCE_LIST) \
		$(PC_TILESET_RESOURCE_ASSETS) $(PC_TILESET_RESOURCE_LIST) \
		$(PC_TILESET_ANIM_RESOURCE_ASSETS) $(PC_TILESET_ANIM_RESOURCE_LIST) \
		$(PC_MUSIC_SAMPLE_RESOURCE_ASSETS) $(PC_MUSIC_SAMPLE_RESOURCE_LIST) \
		$(RESOURCE_PACK_MANIFEST) $(RESOURCE_PACK_BUILDER)
	$(PYTHON) $(RESOURCE_PACK_BUILDER) build --manifest $(RESOURCE_PACK_MANIFEST) --output $@ --root .

